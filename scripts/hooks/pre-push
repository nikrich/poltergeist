#!/usr/bin/env bash
# pre-push: build + test the native macOS capture helper before pushing
# commits that touch it.
#
# Install once per clone:   scripts/install-hooks.sh
# Bypass for one push:      SKIP_NATIVE_PREPUSH=1 git push
#
# Why: the helper is Swift 6 with strict concurrency, and the CI runner
# (macos-15) compiles it with an older toolchain than a current Xcode. A
# green local build is necessary but not sufficient, so the hook also warns
# when the local Swift major.minor differs from what CI uses.
set -euo pipefail

# Swift major.minor that GitHub's macos-15 runner ships (Xcode 16.4). Update
# when .github/workflows/ci.yml moves runners or pins an Xcode version.
CI_SWIFT_VERSION="6.1"

PKG_DIR="native/macos/ghostbrain-capture"
WATCH_RE='^(native/|scripts/build-native-macos\.sh|scripts/hooks/pre-push|\.github/workflows/ci\.yml)'

if [ "${SKIP_NATIVE_PREPUSH:-0}" = "1" ]; then
  exit 0
fi
if [ "$(uname -s)" != "Darwin" ]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

zero="0000000000000000000000000000000000000000"
touches_native=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$zero" ] && continue          # branch deletion
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    # New branch or unknown remote: compare against the merge-base with the
    # default branch; fall back to "changed" when even that is unavailable.
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || git merge-base "$local_sha" main 2>/dev/null || true)"
    if [ -z "$base" ]; then touches_native=1; break; fi
  else
    base="$remote_sha"
  fi
  if git diff --name-only "$base" "$local_sha" | grep -qE "$WATCH_RE"; then
    touches_native=1
    break
  fi
done

if [ "$touches_native" != "1" ]; then
  exit 0
fi

if ! command -v swift >/dev/null 2>&1; then
  echo "pre-push: commits touch $PKG_DIR but 'swift' is not installed; skipping local build (CI will build it)." >&2
  exit 0
fi

local_swift="$(swift --version 2>/dev/null | sed -nE 's/.*Swift version ([0-9]+\.[0-9]+).*/\1/p' | head -1)"
if [ -n "$local_swift" ] && [ "$local_swift" != "$CI_SWIFT_VERSION" ]; then
  cat >&2 <<EOF
pre-push: local Swift is $local_swift, CI (macos-15 runner) uses $CI_SWIFT_VERSION.
          A newer compiler infers Sendable transfers the older one rejects, so
          a green build here does not guarantee a green CI. Check the
          native-macos job after pushing.
EOF
fi

echo "pre-push: native helper changed — running swift build + swift test in $PKG_DIR" >&2
(
  cd "$PKG_DIR"
  swift build -c release 2>&1 | grep -E "error|warning|Build complete" || true
  swift build -c release >/dev/null 2>&1
  swift test 2>&1 | grep -E "error:|Executed .* tests" | tail -1
  swift test >/dev/null 2>&1
) || {
  echo "pre-push: swift build/test failed; push aborted (SKIP_NATIVE_PREPUSH=1 to bypass)." >&2
  exit 1
}
echo "pre-push: native helper OK" >&2
